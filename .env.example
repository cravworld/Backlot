# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# Supabase (or any Postgres) connection string.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Document/media store — org master key for envelope encryption at rest.
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No plaintext-storage fallback exists if this is unset — lib/media.ts
# throws rather than silently storing files unencrypted.
MEDIA_MASTER_KEY="replace-me"

# Phase 1: Supabase Storage (S3-compatible) — the real backend for
# lib/media.ts's S3 branch, per phase-1-findings.md. Same Supabase project
# as DATABASE_URL, one less credential set to manage. All four must be set
# for a new upload to use S3; if any are missing, storeMediaFile() falls
# back to local disk (dev-only — never a production posture).
# Endpoint: https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT="replace-me"
SUPABASE_S3_ACCESS_KEY_ID="replace-me"
SUPABASE_S3_SECRET_ACCESS_KEY="replace-me"
SUPABASE_S3_BUCKET="replace-me"
# Supabase Storage ignores region, but the AWS SDK requires one — any value works.
SUPABASE_S3_REGION="us-east-1"

# Notification/dispatch service — WhatsApp Cloud API (per phase-0-findings.md
# open question 6: real WhatsApp Business API application status is a
# separate, non-code-blocking track). Dispatch throws a clear error, not a
# fake success, when these are unset.
WHATSAPP_ACCESS_TOKEN="replace-me"
WHATSAPP_PHONE_NUMBER_ID="replace-me"
# Used to verify inbound webhook signatures (X-Hub-Signature-256). Also
# unset in dev is allowed (verifyWebhookSignature returns "unverified"),
# but a real deployment must set it.
WHATSAPP_APP_SECRET="replace-me"
# Arbitrary string you choose, used only for Meta's webhook-registration
# GET handshake (hub.verify_token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-me"

# Email fallback — Resend (an assumption, not a spec'd vendor; see
# lib/notifications/email-adapter.ts).
RESEND_API_KEY="replace-me"
NOTIFICATIONS_EMAIL_FROM="notifications@example.com"
RESEND_WEBHOOK_SECRET="replace-me"

# OrchaLLM gateway stub — Anthropic Messages API. Dispatch throws a clear
# error, not a fake completion, when unset. The registered provider is
# seeded as zero-retention=false (see prisma/seed.ts) — a standard API
# key does not carry a zero-data-retention agreement by default.
ANTHROPIC_API_KEY="replace-me"
