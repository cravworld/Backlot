// Backlot — Phase 0 schema.
// Component 1 (Identity & RBAC): Organization, User, OrgMembership, Role,
//   RolePermission, RoleFieldAccess, FilmAssignment.
// Component 2 (Film registry): Film, FilmSettings — Film started as a
//   minimal FK stub for FilmAssignment in component 1; this component
//   fleshes it out with real management UI (create/edit/assign).
// Component 3 (People registry): Person, PersonFilmRole. Deliberately a
//   separate concept from User/FilmAssignment — a junior artist needs a
//   Person record to appear on a distribution list but will never log in.
// Component 4 (Audit log): AuditEvent. Applies retroactively to every
//   write in components 1-3 (see lib/audit.ts) — writes are always
//   logged; reads are logged only for the sensitive cases identified in
//   phase-0-findings.md open question 3 (Person contact-field views).
// Component 5 (Document/media store): MediaAsset, MediaAssetVersion.
//   Envelope encryption at rest (per-file DEK wrapped by an org master
//   key, sign-off open question 4) — see lib/media.ts. Access events
//   (view/download) feed AuditEvent rather than a bespoke log, per
//   sign-off open question 5. Person.photoMediaId now lands as planned —
//   the FK exists, but no photo-upload UI is built yet (out of scope for
//   this component's pass; see phase-0 checklist).
// Component 6 (Notification/dispatch service): NotificationTemplate,
//   NotificationMessage. Provider-agnostic per phase-0-findings.md §1.5
//   — see lib/notifications/. Real WhatsApp Cloud API + Resend adapters
//   built against their documented shapes per sign-off open question 6
//   ("build the adapter against the documented API shape regardless of
//   approval status"), even though no live WhatsApp Business account or
//   email provider is configured yet. The minors safe-default from
//   sign-off open question 9 (opt-in only, not opt-out) is enforced here
//   — this is the first component where Person.isMinor actually gates
//   something.
// Component 7 (OrchaLLM gateway stub): LlmProvider, LlmRequestLog. Per
//   phase-0-findings.md §1.6 — no module ever calls an LLM provider
//   directly, everything routes through lib/orchallm/gateway.ts, which
//   refuses to route a sensitivity-tagged call to a non-zero-retention
//   provider. LlmRequestLog never stores raw prompt/response text, only
//   hashes — see lib/orchallm/gateway.ts for why that's enforced even on
//   the Phase 0 test screen, not just the schema.
//
// See phase-0-findings.md section 1 for the model this implements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Org
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  orgMemberships OrgMembership[]
  roles          Role[]
  films          Film[]
  people         Person[]
  auditEvents    AuditEvent[]
  mediaAssets    MediaAsset[]
  notificationTemplates NotificationTemplate[]
  notificationMessages  NotificationMessage[]
  llmRequestLogs        LlmRequestLog[]

  @@map("organization")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orgMemberships  OrgMembership[]
  filmAssignments FilmAssignment[]
  // Optional 1:1 — set only when this login also corresponds to a human
  // tracked in the People registry (most crew won't have a User at all).
  person          Person?
  auditEvents     AuditEvent[]
  uploadedMediaAssets        MediaAsset[]
  uploadedMediaAssetVersions MediaAssetVersion[]
  llmRequestLogs             LlmRequestLog[]

  @@map("user")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// Org-level power: create films, manage the role catalog, manage the
// role_permission grid. Independent of any single film.
model OrgMembership {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgRole   OrgRole
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@map("org_membership")
}

// ---------------------------------------------------------------------------
// Role catalog + permission grid
// ---------------------------------------------------------------------------

// Org-scoped, user-editable catalog of role types ("1st AD", "Location
// Manager", ...). Not hardcoded — a company will have idiosyncratic titles.
model Role {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String
  label       String
  description String?
  createdAt   DateTime @default(now())

  permissions     RolePermission[]
  fieldAccess     RoleFieldAccess[]
  filmAssignments FilmAssignment[]
  personFilmRoles PersonFilmRole[]

  @@unique([orgId, key])
  @@map("role")
}

// role -> module -> capability. `capability` is a free string, not a fixed
// enum, so a module can add a new action (e.g. "dispatch") without a
// migration. A `view` capability on a module is what makes it appear in
// that role's nav rail.
model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleKey  String
  capability String
  createdAt  DateTime @default(now())

  @@unique([roleId, moduleKey, capability])
  @@map("role_permission")
}

// Generic field-level visibility grant, keyed to a tag on the sensitive
// column rather than one row per field. First consumer will be the People
// registry's contact fields; same mechanism covers LocationBank's owner
// contact/rate fields later without a bespoke visibility system per module.
enum FieldGroup {
  CONTACT_RESTRICTED
  RATE_RESTRICTED
}

model RoleFieldAccess {
  id         String     @id @default(cuid())
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  fieldGroup FieldGroup
  canView    Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@unique([roleId, fieldGroup])
  @@map("role_field_access")
}

// ---------------------------------------------------------------------------
// Film (minimal stub — see file header)
// ---------------------------------------------------------------------------

enum FilmStatus {
  PREP
  SHOOT
  POST
  WRAPPED
  ARCHIVED
}

model Film {
  id              String     @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title           String
  workingTitle    String?
  status          FilmStatus @default(PREP)
  startDate       DateTime?
  endDate         DateTime?
  primaryLanguage String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  filmAssignments FilmAssignment[]
  settings        FilmSettings[]
  personRoles     PersonFilmRole[]
  auditEvents     AuditEvent[]
  mediaAssets     MediaAsset[]
  notificationMessages NotificationMessage[]
  llmRequestLogs  LlmRequestLog[]

  @@map("film")
}

// Generic per-film key/value escape hatch for module-agnostic config that
// doesn't obviously belong to a specific module's own table (sign-off:
// keep as jsonb now, promote a key to an explicit column later if it
// starts being queried heavily).
model FilmSettings {
  id        String   @id @default(cuid())
  filmId    String
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([filmId, key])
  @@map("film_settings")
}

// ---------------------------------------------------------------------------
// Film assignment — binds a logged-in user to a film with a role.
// This is what RBAC actually reads at request time.
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

model FilmAssignment {
  id         String           @id @default(cuid())
  filmId     String
  film       Film             @relation(fields: [filmId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role             @relation(fields: [roleId], references: [id])
  department String?
  status     AssignmentStatus @default(ACTIVE)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime         @default(now())

  @@unique([filmId, userId, roleId])
  @@map("film_assignment")
}

// ---------------------------------------------------------------------------
// People registry — one record per human (crew, cast, vendors), org-wide
// and independent of login. Referenced by every module; the source of
// truth is managed on /people (org-admin only, full fields visible since
// it's the data-entry surface). Per-film crew views elsewhere in the app
// filter phone/email/whatsappNumber through role_field_access instead of
// showing them unconditionally — that's a deliberate, separate boundary
// from the /people admin screen, not an oversight.
// ---------------------------------------------------------------------------

model Person {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fullName       String
  preferredName  String?
  // Tagged FieldGroup.CONTACT_RESTRICTED at the application layer — never
  // rendered outside /people without a role_field_access grant for the
  // viewer's current-film role.
  phone          String?
  email          String?
  whatsappNumber String?
  languages      String[]
  // Flagged loudly per the deep-dive's instruction, not silently. Phase 0
  // has no distribution feature yet to actually exclude minors from — the
  // rule (opt-in, not opt-out, once that feature exists) is recorded in
  // phase-0-findings.md open question 9. This flag exists now so the data
  // is captured from day one rather than retrofitted.
  isMinor        Boolean  @default(false)
  notes          String?
  // Optional link to a login — set only when this person also has
  // platform access (e.g. a 1st AD is both a Person and a User).
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  // Lands with the Document/media store component, as flagged in that
  // component's schema header comment. FK only — no photo-upload UI yet;
  // building that is a separate pass so this one stays one upload surface.
  photoMediaId   String?
  photoMedia     MediaAsset? @relation("PersonPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  filmRoles PersonFilmRole[]
  notificationMessages NotificationMessage[]

  @@map("person")
}

// The domain-level "who's on this film, in what capacity" record that
// CallSheet Ops' recipient model will read from — distinct from
// FilmAssignment, which governs login/RBAC. A person can hold a
// PersonFilmRole with no corresponding FilmAssignment at all (most crew).
model PersonFilmRole {
  id                 String    @id @default(cuid())
  personId           String
  person             Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  filmId             String
  film               Film      @relation(fields: [filmId], references: [id], onDelete: Cascade)
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  department         String?
  contactChannelPref String?
  languagePref       String?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime  @default(now())

  @@unique([personId, filmId, roleId])
  @@map("person_film_role")
}

// ---------------------------------------------------------------------------
// Audit log — applies to every write across every table above, from this
// component onward. Populated exclusively from the shared lib/audit.ts
// helper (never a DB trigger) so actor/IP/user-agent — only available at
// the request level — are always captured correctly.
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
}

model AuditEvent {
  id          String         @id @default(cuid())
  orgId       String
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Nullable + SetNull: an audit row must survive the film or actor it
  // references being deleted — the record of what happened matters more
  // than keeping a live FK.
  filmId      String?
  film        Film?          @relation(fields: [filmId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorType   AuditActorType @default(USER)
  // Free strings, not enums — same reasoning as RolePermission.capability:
  // new actions/entity types shouldn't need a migration.
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Document / media store — MediaAsset is the stable logical document
// identity; MediaAssetVersion rows are immutable per-version blob records
// (uploading again always inserts a new version, never edits one). Real
// envelope encryption at rest: lib/media.ts generates a fresh per-file
// data-encryption key, encrypts the file with it, then wraps that key with
// an org master key from MEDIA_MASTER_KEY — encryptionKeyRef stores the
// wrapped key, never a raw key. Access events (view/download) are not a
// separate table; they write into AuditEvent like everything else, per
// sign-off open question 5.
// ---------------------------------------------------------------------------

enum StorageProvider {
  LOCAL
  S3
}

model MediaAsset {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Nullable per phase-0-findings.md §1.4 (org-wide documents with no
  // single film owner are legal), though every upload surface built so
  // far always sets it — there's no org-wide upload screen yet.
  filmId           String?
  film             Film?    @relation(fields: [filmId], references: [id], onDelete: SetNull)
  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  // Display name for the logical document. Not in the original findings
  // doc's column list for media_asset — added because a document store
  // with no human-readable name isn't usable in a UI or a download's
  // Content-Disposition header. Flagged as an assumption, not a silent
  // schema drift.
  filename         String
  mimeType         String
  currentVersionId String?  @unique
  currentVersion   MediaAssetVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions       MediaAssetVersion[] @relation("AssetVersions")
  personPhotoOf  Person[]            @relation("PersonPhoto")

  @@map("media_asset")
}

model MediaAssetVersion {
  id               String          @id @default(cuid())
  mediaAssetId     String
  mediaAsset       MediaAsset      @relation("AssetVersions", fields: [mediaAssetId], references: [id], onDelete: Cascade)
  versionNumber    Int
  storageProvider  StorageProvider @default(LOCAL)
  // Opaque handle into local disk (storage/media/<storageKey>) or, later,
  // an S3 object key — never a filesystem path the client controls.
  storageKey       String
  // Byte size and checksum are computed over the *plaintext*, not the
  // ciphertext — this is a statement about the logical file's integrity,
  // not the encrypted blob's.
  byteSize         Int
  checksumSha256   String
  // Wrapped per-file DEK: base64(iv || authTag || AES-256-GCM(dek)),
  // encrypted under MEDIA_MASTER_KEY. See lib/media.ts wrapKey/unwrapKey.
  // Never store a raw DEK here.
  encryptionKeyRef String
  originalFilename String
  uploadedByUserId String
  uploadedByUser   User            @relation(fields: [uploadedByUserId], references: [id])
  changeNote       String?
  createdAt        DateTime        @default(now())

  currentFor MediaAsset? @relation("CurrentVersion")

  @@unique([mediaAssetId, versionNumber])
  @@map("media_asset_version")
}

// ---------------------------------------------------------------------------
// Notification / dispatch service — schema-level, provider-agnostic per
// phase-0-findings.md §1.5. No module (this one included) talks to a
// WhatsApp or email SDK directly; everything routes through
// lib/notifications/dispatch.ts, which enforces the minors safe-default
// (sign-off open question 9) before any adapter is ever called.
// Template *content* authoring is explicitly out of Phase 0 scope (see
// findings doc's "not building" list) — templates are seeded, not
// UI-managed.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model NotificationTemplate {
  id           String              @id @default(cuid())
  orgId        String
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key          String
  channel      NotificationChannel
  language     String
  // Email only — WhatsApp Cloud API messages have no separate subject line.
  subject      String?
  bodyTemplate String
  createdAt    DateTime            @default(now())

  messages NotificationMessage[]

  @@unique([orgId, key, channel, language])
  @@map("notification_template")
}

model NotificationMessage {
  id                String               @id @default(cuid())
  orgId             String
  org               Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  filmId            String?
  film              Film?                @relation(fields: [filmId], references: [id], onDelete: SetNull)
  templateId        String?
  template          NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  recipientPersonId String?
  recipientPerson   Person?              @relation(fields: [recipientPersonId], references: [id], onDelete: SetNull)
  // The resolved phone/email actually dispatched to — kept out of
  // AuditEvent payloads (PII), same discipline as media.ts excluding
  // storage keys/encryption refs from its audit entries.
  recipientContact  String
  bodyRendered      String
  status            NotificationStatus   @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedReason      String?
  createdAt         DateTime             @default(now())

  @@index([orgId, createdAt])
  @@index([providerMessageId])
  @@map("notification_message")
}

// ---------------------------------------------------------------------------
// Model gateway (OrchaLLM stub) — no module ever calls an LLM provider
// directly, per phase-0-findings.md §1.6; everything routes through
// lib/orchallm/gateway.ts. LlmProvider is deliberately NOT org-scoped —
// it's a catalog of provider *types* (same providers exist regardless of
// which org is calling), not per-org credentials or per-org rows.
// LlmRequestLog IS org-scoped and never holds raw prompt/response text,
// only hashes — enough to reconstruct "who asked what kind of question,
// when, against which provider" for an audit without holding the
// sensitive content itself.
// ---------------------------------------------------------------------------

model LlmProvider {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  zeroRetention Boolean  @default(false)
  // Module keys allowed to route to this provider; empty = allowed for
  // any module. Independent of the zero-retention gate below — a second,
  // narrower allowlist for cases like RightsLedger needing a specific
  // provider later, per phase-0-findings.md.
  allowedFor    String[] @default([])
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("llm_provider")
}

model LlmRequestLog {
  id                String   @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  filmId            String?
  film              Film?    @relation(fields: [filmId], references: [id], onDelete: SetNull)
  requestedByUserId String?
  requestedByUser   User?    @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  moduleKey         String
  purpose           String
  // Plain string, not a relation to LlmProvider — a request that was
  // refused before any provider was selected still needs to log
  // something (e.g. "none"), and findings.md lists this as a flat column.
  providerKey       String
  model             String
  promptHash        String
  responseHash      String?
  tokenCountIn      Int?
  tokenCountOut     Int?
  zeroRetentionUsed Boolean  @default(false)
  // Free string, not an enum — same reasoning as AuditEvent.action:
  // "ok" | "refused" | "failed" today, new outcomes shouldn't need a
  // migration.
  status            String
  failedReason      String?
  createdAt         DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("llm_request_log")
}
